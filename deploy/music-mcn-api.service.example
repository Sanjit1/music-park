[Unit]
Description=Music Collaboration Number API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sanjit/music-park
EnvironmentFile=/home/sanjit/music-park/deploy/.env
ExecStart=/home/sanjit/miniconda3/envs/music-park/bin/python scripts/run_api.py --host 0.0.0.0 --graph /home/sanjit/music-park/data/artifacts/current --cache-db /home/sanjit/music-park/data/cache/mcn_cache.sqlite
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
