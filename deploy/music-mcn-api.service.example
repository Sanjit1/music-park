[Unit]
Description=Music Collaboration Number API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sanjit/music-park
EnvironmentFile=/home/sanjit/music-park/deploy/.env
ExecStart=/usr/bin/python3 scripts/run_api.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
